if(NOT DEFINED INPUT_BIN)
  message(FATAL_ERROR "INPUT_BIN is required")
endif()

if(NOT DEFINED OUTPUT_DIR)
  message(FATAL_ERROR "OUTPUT_DIR is required")
endif()

if(NOT DEFINED VERSION_HEADER)
  message(FATAL_ERROR "VERSION_HEADER is required")
endif()

file(READ "${VERSION_HEADER}" VERSION_HEADER_TEXT)
string(REGEX MATCH
       "#[ \t]*define[ \t]+APP_IAP_VERSION[ \t]+0x([0-9A-Fa-f]+)U?"
       APP_VERSION_MATCH
       "${VERSION_HEADER_TEXT}")

if(NOT APP_VERSION_MATCH)
  message(FATAL_ERROR "APP_IAP_VERSION not found in ${VERSION_HEADER}")
endif()

set(APP_VERSION_HEX "${CMAKE_MATCH_1}")
string(LENGTH "${APP_VERSION_HEX}" APP_VERSION_HEX_LENGTH)
if(NOT APP_VERSION_HEX_LENGTH EQUAL 8)
  message(FATAL_ERROR "APP_IAP_VERSION must use 8 hex digits, got 0x${APP_VERSION_HEX}")
endif()

string(SUBSTRING "${APP_VERSION_HEX}" 2 2 APP_VERSION_MAJOR_HEX)
string(SUBSTRING "${APP_VERSION_HEX}" 4 2 APP_VERSION_MINOR_HEX)
string(SUBSTRING "${APP_VERSION_HEX}" 6 2 APP_VERSION_PATCH_HEX)

math(EXPR APP_VERSION_MAJOR "0x${APP_VERSION_MAJOR_HEX}")
math(EXPR APP_VERSION_MINOR "0x${APP_VERSION_MINOR_HEX}")
math(EXPR APP_VERSION_PATCH "0x${APP_VERSION_PATCH_HEX}")

set(VERSIONED_BIN
    "${OUTPUT_DIR}/WashingPets_APP_V${APP_VERSION_MAJOR}.${APP_VERSION_MINOR}.${APP_VERSION_PATCH}.bin")

configure_file("${INPUT_BIN}" "${VERSIONED_BIN}" COPYONLY)
message(STATUS "Versioned APP bin: ${VERSIONED_BIN}")
